{
  "openapi": "3.1.0",
  "info": {
    "title": "AKAC Reference Gateway",
    "version": "0.2.0",
    "description": "Service-side API. Credentials bind tenant, user, agent and run grant. Exactly one configured authentication mode: opaque service token or verified at+jwt access token; trusted mappings determine authority."
  },
  "paths": {
    "/v1/retrieve": {
      "post": {
        "operationId": "retrieve",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "query": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "purpose": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 20
                  }
                },
                "required": [
                  "query",
                  "purpose"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authorized result; response body includes ok=true and value",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthorizedResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid closed request envelope",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/XRequestId"
              }
            }
          },
          "401": {
            "description": "Missing or invalid credential",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/XRequestId"
              }
            }
          },
          "403": {
            "description": "No authorized result; same shape for hidden and nonexistent objects",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeniedResult"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 128 KiB",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/XRequestId"
              }
            }
          },
          "429": {
            "description": "Rate limit",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/XRequestId"
              }
            }
          },
          "503": {
            "description": "Dependency or transaction failure; no result released",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/XRequestId"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "x-akac-execution-id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
            },
            "description": "Optional agent execution id (0.5, ADR-012), recorded as executionId with the audited decision. Correlation only, never authority; a malformed value is a 400. A runtime revision is never accepted over HTTP."
          }
        ]
      }
    },
