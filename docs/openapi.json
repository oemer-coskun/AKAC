{
  "openapi": "3.1.0",
  "info": {
    "title": "AKAC Reference Gateway",
    "version": "0.2.0",
    "description": "Service-side API. Credentials bind tenant, user, agent and run grant. Exactly one configured authentication mode: opaque service token or verified at+jwt access token; trusted mappings determine authority."
  },
  "paths": {
    "/v1/retrieve": {
      "post": {
        "operationId": "retrieve",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "query": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "purpose": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 20
                  }
                },
                "required": [
                  "query",
                  "purpose"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authorized result; response body includes ok=true and value"
          },
          "400": {
            "description": "Invalid closed request envelope"
          },
          "401": {
            "description": "Missing or invalid credential"
          },
          "403": {
            "description": "No authorized result; same shape for hidden and nonexistent objects"
          },
          "413": {
            "description": "Body exceeds 128 KiB"
          },
          "429": {
            "description": "Rate limit"
          },
          "503": {
            "description": "Dependency or transaction failure; no result released"
          }
        }
      }
    },
    "/v1/contexts": {
      "post": {
        "operationId": "contexts",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "resources": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 64,
                    "items": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
                      "not": {
                        "enum": [
                          "constructor",
                          "prototype",
                          "__proto__"
                        ]
                      }
                    }
                  },
                  "purpose": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                },
                "required": [
                  "resources",
                  "purpose"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authorized result; response body includes ok=true and value"
          },
          "400": {
            "description": "Invalid closed request envelope"
          },
          "401": {
            "description": "Missing or invalid credential"
          },
          "403": {
            "description": "No authorized result; same shape for hidden and nonexistent objects"
          },
          "413": {
            "description": "Body exceeds 128 KiB"
          },
          "429": {
            "description": "Rate limit"
          },
          "503": {
            "description": "Dependency or transaction failure; no result released"
          }
        }
      }
    },
    "/v1/derive": {
      "post": {
        "operationId": "derive",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "context": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
                    "not": {
                      "enum": [
                        "constructor",
                        "prototype",
                        "__proto__"
                      ]
                    }
                  },
                  "content": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100000
                  },
                  "kind": {
                    "enum": [
                      "memory",
                      "artifact"
                    ]
                  }
                },
                "required": [
                  "context",
                  "content",
                  "kind"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authorized result; response body includes ok=true and value"
          },
          "400": {
            "description": "Invalid closed request envelope"
          },
          "401": {
            "description": "Missing or invalid credential"
          },
          "403": {
            "description": "No authorized result; same shape for hidden and nonexistent objects"
          },
          "413": {
            "description": "Body exceeds 128 KiB"
          },
          "429": {
            "description": "Rate limit"
          },
          "503": {
            "description": "Dependency or transaction failure; no result released"
          }
        }
      }
    },
    "/v1/release": {
      "post": {
        "operationId": "release",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "context": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
                    "not": {
                      "enum": [
                        "constructor",
                        "prototype",
                        "__proto__"
                      ]
                    }
                  },
                  "recipient": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
                    "not": {
                      "enum": [
                        "constructor",
                        "prototype",
                        "__proto__"
                      ]
                    }
                  },
                  "content": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100000
                  },
                  "action": {
                    "enum": [
                      "share",
                      "export"
                    ]
                  }
                },
                "required": [
                  "context",
                  "recipient",
                  "content",
                  "action"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authorized result; response body includes ok=true and value"
          },
          "400": {
            "description": "Invalid closed request envelope"
          },
          "401": {
            "description": "Missing or invalid credential"
          },
          "403": {
            "description": "No authorized result; same shape for hidden and nonexistent objects"
          },
          "413": {
            "description": "Body exceeds 128 KiB"
          },
          "429": {
            "description": "Rate limit"
          },
          "503": {
            "description": "Dependency or transaction failure; no result released"
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "health",
        "security": [],
        "responses": {
          "200": {
            "description": "Process liveness; not authorization readiness"
          },
          "503": {
            "description": "Admission capacity exhausted"
          }
        }
      }
    },
    "/ready": {
      "get": {
        "operationId": "ready",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "State schema, audit chain and configured policy revision ready"
          },
          "401": {
            "description": "Missing or invalid credential"
          },
          "429": {
            "description": "Per-binding rate limit"
          },
          "503": {
            "description": "State, audit, policy or capacity unavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
