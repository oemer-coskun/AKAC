{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutation testing against the portable conformance vectors alone (npm run conformance, no unit tests): the surviving mutants are behaviours no vector distinguishes. See docs/CONFORMANCE-COVERAGE.md.",
  "testRunner": "command",
  "commandRunner": { "command": "node conformance/run.ts" },
  "coverageAnalysis": "off",
  "mutate": [
    "reference/policy.ts",
    "reference/containment.ts",
    "reference/decision.ts",
    "reference/lifecycle.ts"
  ],
  "ignorePatterns": [
    ".git", "node_modules/.cache", "reports", "bench", "deploy", "docs", "formal", "governance", "legal", "scripts", "tests", "implementations"
  ],
  "reporters": ["clear-text", "progress", "json", "html"],
  "jsonReporter": { "fileName": "reports/mutation-vectors/mutation.json" },
  "htmlReporter": { "fileName": "reports/mutation-vectors/index.html" },
  "thresholds": { "high": 90, "low": 75, "break": 0 },
  "tempDirName": ".stryker-tmp-vectors",
  "cleanTempDir": true,
  "concurrency": 4,
  "timeoutMS": 60000,
  "timeoutFactor": 2
}
