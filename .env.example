# Generate random hexadecimal values; hex avoids URL-encoding ambiguity.
# Database passwords are files, never values and never part of a connection URL.
# Compose reads ./secrets/pg_owner_password and ./secrets/pg_app_password (create them
# as described in docs/QUICKSTART.md) and mounts them under /run/secrets. Outside Compose, set the matching *_PASSWORD_FILE
# variables (AKAC_DATABASE_PASSWORD_FILE, AKAC_MIGRATION_DATABASE_PASSWORD_FILE and, for
# retrieval, AKAC_VECTOR_DATABASE_PASSWORD_FILE / AKAC_VECTOR_RESTRICTED_DATABASE_PASSWORD_FILE).
# Two distinct Postgres roles: an owner role that runs migrations (akac_owner)
# and a non-owner runtime role without BYPASSRLS that the gateway uses to
# serve traffic (akac_app). See deploy/postgres/init.sql.
# Optional: OpenAI-compatible embedding provider. When set, egress must be
# restricted to this host only (egress policy is the operator's responsibility).
AKAC_EMBEDDINGS_URL=
AKAC_EMBEDDINGS_MODEL=
# Vector dimension; must equal the pgvector column (256 unless you add a migration).
# AKAC_EMBEDDINGS_DIMENSIONS=256
# Embedding API key: a file path, never a value (mount a secret and point to it).
# AKAC_EMBEDDINGS_API_KEY_FILE=

# Retrieval: lexical (default) or vector. compose.yaml enables vector with the
# synthetic HashEmbedder (AKAC_EMBEDDINGS=hash, AKAC_ALLOW_HASH_EMBEDDER=true);
# do not use that combination for real content.
# AKAC_RETRIEVAL=vector
# AKAC_VECTOR_BACKEND=pgvector
# AKAC_VECTOR_DATABASE_URL=            # no password in the URL
# AKAC_VECTOR_DATABASE_PASSWORD_FILE=
# AKAC_VECTOR_RESTRICTED_DATABASE_URL=
# AKAC_VECTOR_RESTRICTED_DATABASE_PASSWORD_FILE=
# AKAC_RETRIEVAL_MIN_SCORE=0.2

# 0.6 (docs/SUPPORT-MATRIX.md). All optional; the defaults are the secure ones.
# What the HTTP gateway does with runtime_profile obligations: deny (default) or trusted-enforcer (only behind a tested runtime enforcer).
# AKAC_RUNTIME_OBLIGATIONS=deny
# Shared rate limits, idempotency records and job locks: postgres (default with DATABASE_URL) or memory (per replica).
# AKAC_SHARED_STATE=postgres
# Checkpoint algorithm: ed25519 (default), ed25519+ml-dsa-65, ml-dsa-44|65|87, slh-dsa-sha2-128s|256s; needs AKAC_CHECKPOINT_KEY_FILE
# and AKAC_CHECKPOINT_KEY_ID=<algorithm>:<label> for anything but ed25519.
# AKAC_CHECKPOINT_ALG=ed25519
# Content encryption at rest: off (default) or provider (an enterprise KMS/HSM key provider from an extension; the local development
# provider AKAC_CONTENT_ENCRYPTION=local with AKAC_CONTENT_KEY_FILE is refused when NODE_ENV=production).
# AKAC_CONTENT_ENCRYPTION=off
# Model lineage of derived content (both or neither).
# AKAC_MODEL_ID=
# AKAC_MODEL_VERSION=
# Release and retrieval protection (docs/RELEASE-PROTECTION.md).
# AKAC_MIN_RESPONSE_MS=100
# AKAC_RESPONSE_JITTER_MS=20
# AKAC_DENIAL_HINTS=false
# AKAC_BACKOFF_FREE_DENIALS=5
# AKAC_VOLUME_LIMITS=confidential:bytes=1048576,documents=100;restricted:bytes=65536,documents=10
# AKAC_VOLUME_WINDOW_SECONDS=3600
# AKAC_VOLUME_ON_EXCEED=deny
# AKAC_DECISION_CACHE_TTL_MS=5000
# AKAC_RELEASE_REQUIRED_FILTERS=confidential=pii;restricted=pii,dlp
# AKAC_HOOKS_MODULE=            # path to an ES module exporting releaseFilters and deriveSanitizers
# Embedding anchors (vector retrieval only): a persistent baseline file is required; the first start needs AKAC_ANCHOR_BOOTSTRAP=true once.
# AKAC_ANCHOR_TEXTS_FILE=
# AKAC_ANCHOR_BASELINE_FILE=
# AKAC_ANCHOR_THRESHOLD=0.98
# AKAC_ANCHOR_INTERVAL_SECONDS=300
