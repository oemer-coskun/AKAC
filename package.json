{
  "name": "@akac/reference",
  "version": "0.5.0",
  "private": true,
  "description": "Agent Knowledge Access Control: draft specification, reference implementation and conformance suite",
  "type": "module",
  "license": "MIT-0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check": "tsc --noEmit && npm test",
    "test": "node --test tests/*.test.ts",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.ts",
    "test:opa": "opa test policies/ -v",
    "demo": "node examples/demo.ts",
    "start": "node reference/server.ts",
    "seed": "node scripts/seed.ts",
    "migrate": "node scripts/migrate.ts",
    "conformance": "node conformance/run.ts",
    "test:postgres": "node --test tests/postgres.test.ts",
    "test:bonus": "node --test \"bonus/**/*.test.ts\"",
    "check:all": "npm run check && npm run test:bonus"
  },
  "dependencies": {
    "jose": "6.2.12",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "ajv": "8.20.0",
    "fast-check": "4.10.2",
    "typescript": "5.9.3"
  }
}
