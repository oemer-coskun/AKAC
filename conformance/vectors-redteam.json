    {
      "id": "RT-001-trust-laundering-summary-memory-retrieve",
      "kind": "scenario",
      "description": "Restricted source summarized into memory by a cleared agent; a lower-clearance user retrieves it.",
      "tags": [
        "trust-laundering"
      ],
      "clock": 1800000000000,
      "steps": [
        {
          "op": "open",
          "as": "chief",
          "resources": [
            "strategy"
          ],
          "purpose": "work",
          "save": "c1",
          "expect": "allow"
        },
        {
          "op": "derive",
          "as": "chief",
          "context": "$c1",
          "kind": "memory",
          "content": "Product strategy summary: purchase budget figures.",
          "save": "m1",
          "expect": "allow"
        },
        {
          "op": "retrieve",
          "as": "intern",
          "query": "product strategy summary",
          "purpose": "work",
          "target": [
            "$m1"
          ],
          "probe": true
        }
      ],
      "expected": "deny"
    },
    {
