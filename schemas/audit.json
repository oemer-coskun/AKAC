{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oemer-coskun/AKAC/schemas/audit.json",
  "description": "One entry of a tenant audit stream. Format 1 (no formatVersion): hash = SHA-256 of sorted-key JSON of the other members. Format 2: hash = SHA-256 of the RFC 8785 (JCS) form of the other members. Format 2 members runId, traceId, executionId and runtimeRevision are optional; executionId and runtimeRevision were added by 0.5 (ADR-012) and are absent from earlier entries. Both: previous = hash of the preceding entry of the stream (GENESIS = 64 zeros); RFC 9162 leaf = SHA-256(0x00 || JCS(entry)).",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "time",
        "tenant",
        "actor",
        "operation",
        "decision",
        "reason",
        "policyVersion",
        "epoch",
        "previous",
        "hash"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "time": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tenant": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
          "not": {
            "enum": [
              "constructor",
              "prototype",
              "__proto__"
            ]
          }
        },
        "actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "operation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "decision": {
          "enum": [
            "allow",
            "deny"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "policyVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "previous": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "time",
        "tenant",
        "actor",
        "operation",
        "decision",
        "reason",
        "policyVersion",
        "epoch",
        "previous",
        "hash",
        "formatVersion",
        "decisionId",
        "reasonCode",
        "policyDigest",
        "obligations"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "time": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tenant": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
          "not": {
            "enum": [
              "constructor",
              "prototype",
              "__proto__"
            ]
          }
        },
        "actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "operation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "decision": {
          "enum": [
            "allow",
            "deny"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "policyVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "previous": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "formatVersion": {
          "const": 2
        },
        "decisionId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "description": "UUIDv4"
        },
        "reasonCode": {
          "enum": [
            "AUTHORIZED",
            "PROTECTED_DERIVATION",
            "AUTHORIZED_RECIPIENT",
            "ATTENUATED",
            "IDEMPOTENT_REPLAY",
            "INVALID_REQUEST",
            "NOT_AUTHORIZED",
            "INVALID_CONTEXT",
            "IDENTITY_BOUNDARY",
            "INVALID_DELEGATION",
            "OUT_OF_SCOPE",
            "UNSUPPORTED_OBLIGATION",
            "SOD_VIOLATION",
            "KNOWLEDGE_BOUNDARY",
            "POLICY_DENIED",
            "POLICY_UNAVAILABLE",
            "STALE_CONTEXT",
            "STALE_SOURCE",
            "EXPIRED",
            "RECIPIENT",
            "CANDIDATES_UNAVAILABLE",
            "BUDGET_EXCEEDED",
            "STORE_ERROR",
            "NOT_ADMIN",
            "CONFLICT",
            "IDEMPOTENCY_KEY_REUSED"
          ]
        },
        "policyDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "obligations": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "obligation.json"
          }
        },
        "runId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
          "not": {
            "enum": [
              "constructor",
              "prototype",
              "__proto__"
            ]
          }
        },
        "traceId": {
          "type": "string",
          "pattern": "^(?!0{32}$)[0-9a-f]{32}$",
          "description": "W3C Trace Context trace-id"
        },
        "executionId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
          "not": {
            "enum": [
              "constructor",
              "prototype",
              "__proto__"
            ]
          },
          "description": "Agent execution (sandbox, job) supplied by the caller (0.5, ADR-012); correlation only"
        },
        "runtimeRevision": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
          "not": {
            "enum": [
              "constructor",
              "prototype",
              "__proto__"
            ]
          },
          "description": "Runtime policy revision a trusted runtime enforcer applied (0.5, ADR-012); never taken from an agent over HTTP"
        }
      }
    }
  ]
}
