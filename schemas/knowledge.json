{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oemer-coskun/AKAC/schemas/knowledge.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
      "not": {
        "enum": [
          "constructor",
          "prototype",
          "__proto__"
        ]
      }
    },
    "tenant": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
      "not": {
        "enum": [
          "constructor",
          "prototype",
          "__proto__"
        ]
      }
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "enum": [
        "document",
        "memory",
        "artifact"
      ]
    },
    "origin": {
      "enum": [
        "human",
        "system",
        "model"
      ],
      "description": "Provenance only, never authority. Memory and artifacts are always 'model'."
    },
    "content": {
      "type": "string"
    },
    "classification": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "readerRoles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "readers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
        "not": {
          "enum": [
            "constructor",
            "prototype",
            "__proto__"
          ]
        }
      },
      "uniqueItems": true
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
            "not": {
              "enum": [
                "constructor",
                "prototype",
                "__proto__"
              ]
            }
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "id",
          "version"
        ]
      },
      "uniqueItems": true
    },
    "active": {
      "type": "boolean"
    },
    "accessExpiresAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Exclusive access expiry in Unix milliseconds. Does not erase stored bytes."
    },
    "container": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
      "not": {
        "enum": [
          "constructor",
          "prototype",
          "__proto__"
        ]
      },
      "description": "Nearest knowledge base or folder; every ancestor's label also applies."
    },
    "lifecycle": {
      "enum": [
        "quarantined",
        "erased"
      ],
      "description": "0.4 lifecycle state; absent is normal. Any value hides the record and every record derived from it. 'erased' is a terminal tombstone with empty content."
    },
    "lifecycleAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Unix ms of the last lifecycle transition (for 'erased': the erasure time)."
    },
    "quarantineReason": {
      "enum": [
        "suspected_poisoning",
        "scanner",
        "scanner_unavailable",
        "memory_review",
        "incident",
        "poisoned",
        "ancestor_revoked",
        "model_recall"
      ]
    },
    "retainUntil": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Retention deadline in Unix ms: due for erasure by the retention job. Unlike accessExpiresAt it does not end access."
    },
    "legalHolds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
        "not": {
          "enum": [
            "constructor",
            "prototype",
            "__proto__"
          ]
        }
      },
      "uniqueItems": true,
      "maxItems": 64,
      "description": "Legal hold ids. A non-empty list blocks erasure and retention of this record and of every ancestor."
    },
    "revokedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Unix ms of a security-admin revocation (revoke, revoke-lineage). While present the record stays inactive across new versions; only reinstate clears it."
    },
    "modality": {
      "enum": [
        "text",
        "image",
        "audio",
        "video",
        "table",
        "code",
        "other"
      ],
      "description": "0.6 (R183): content modality. Descriptive only, never authority; derivation inherits labels whatever the modality."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
        "not": {
          "enum": [
            "constructor",
            "prototype",
            "__proto__"
          ]
        }
      },
      "uniqueItems": true,
      "maxItems": 32,
      "description": "0.6 (R186): tags; the effective tags are the union over the record, its containers and every transitive source. Tags never grant access."
    },
    "residency": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9-]{1,15}$"
      },
      "uniqueItems": true,
      "maxItems": 32,
      "description": "0.6 (R187): ISO 3166-1 alpha-2 or operator-defined region codes; the effective residency is the intersection over the record, its containers and every transitive source. When set, share/export reaches only destinations whose region is in it."
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
          "not": {
            "enum": [
              "constructor",
              "prototype",
              "__proto__"
            ]
          }
        },
        "version": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
          "not": {
            "enum": [
              "constructor",
              "prototype",
              "__proto__"
            ]
          }
        }
      },
      "required": [
        "id",
        "version"
      ],
      "description": "0.6 (R191): model that produced derived content; set by the gateway from a trusted runtime path only, never accepted from a caller."
    },
    "ephemeral": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessionId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
          "not": {
            "enum": [
              "constructor",
              "prototype",
              "__proto__"
            ]
          }
        },
        "run": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
          "not": {
            "enum": [
              "constructor",
              "prototype",
              "__proto__"
            ]
          }
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "sessionId",
        "run",
        "expiresAt"
      ],
      "description": "0.6 (R190): session-scoped record held only in the gateway's memory; never present in a persistent store. Visible to its run only, before expiresAt."
    },
    "erasureRequestedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "0.6 (R194): Unix ms an erasure was requested while a legal hold blocked it; the erasure runs once no hold blocks it."
    }
  },
  "required": [
    "id",
    "tenant",
    "version",
    "kind",
    "origin",
    "content",
    "classification",
    "projects",
    "readerRoles",
    "readers",
    "sources",
    "active"
  ],
  "if": {
    "properties": {
      "kind": {
        "enum": [
          "memory",
          "artifact"
        ]
      }
    }
  },
  "then": {
    "properties": {
      "origin": {
        "const": "model"
      }
    }
  }
}
