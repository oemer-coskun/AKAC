{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WestMoneyDE/AKAC/schemas/destination.json",
  "description": "Destination profile (AKAC 0.4, ADR-008): a tenant-scoped egress target class.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
      "not": {
        "enum": [
          "constructor",
          "prototype",
          "__proto__",
          "internal-user",
          "internal-service",
          "model-provider",
          "tool",
          "external"
        ]
      }
    },
    "tenant": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
      "not": {
        "enum": [
          "constructor",
          "prototype",
          "__proto__"
        ]
      }
    },
    "class": {
      "enum": [
        "internal-user",
        "internal-service",
        "model-provider",
        "tool",
        "external"
      ]
    },
    "maxClassification": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "purposes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "uniqueItems": true,
      "maxItems": 64
    },
    "active": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "tenant",
    "class",
    "maxClassification",
    "purposes",
    "active"
  ]
}
