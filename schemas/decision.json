{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oemer-coskun/AKAC/schemas/decision.json",
  "description": "A decision. decide() returns effect, code and category; the engine adds decisionId, policyRevision, policyDigest and obligations (in-process and in audit). HTTP denials never carry code or category.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "effect": {
      "enum": [
        "allow",
        "deny"
      ]
    },
    "code": {
      "enum": [
        "AUTHORIZED",
        "PROTECTED_DERIVATION",
        "AUTHORIZED_RECIPIENT",
        "ATTENUATED",
        "IDEMPOTENT_REPLAY",
        "INVALID_REQUEST",
        "NOT_AUTHORIZED",
        "INVALID_CONTEXT",
        "IDENTITY_BOUNDARY",
        "INVALID_DELEGATION",
        "OUT_OF_SCOPE",
        "UNSUPPORTED_OBLIGATION",
        "SOD_VIOLATION",
        "KNOWLEDGE_BOUNDARY",
        "POLICY_DENIED",
        "POLICY_UNAVAILABLE",
        "STALE_CONTEXT",
        "STALE_SOURCE",
        "EXPIRED",
        "RECIPIENT",
        "CANDIDATES_UNAVAILABLE",
        "BUDGET_EXCEEDED",
        "STORE_ERROR",
        "NOT_ADMIN",
        "CONFLICT",
        "IDEMPOTENCY_KEY_REUSED"
      ]
    },
    "category": {
      "enum": [
        "deny",
        "defer"
      ],
      "description": "deny: definite policy denial. defer: authorization could not be established."
    },
    "decisionId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "UUIDv4"
    },
    "policyRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "policyDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "obligations": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "obligation.json"
      }
    }
  },
  "required": [
    "effect",
    "code"
  ],
  "if": {
    "properties": {
      "effect": {
        "const": "deny"
      }
    }
  },
  "then": {
    "required": [
      "category"
    ],
    "properties": {
      "code": {
        "not": {
          "enum": [
            "AUTHORIZED",
            "PROTECTED_DERIVATION",
            "AUTHORIZED_RECIPIENT",
            "ATTENUATED",
            "IDEMPOTENT_REPLAY"
          ]
        }
      },
      "obligations": {
        "maxItems": 0
      }
    }
  },
  "else": {
    "not": {
      "required": [
        "category"
      ]
    },
    "properties": {
      "code": {
        "enum": [
          "AUTHORIZED",
          "PROTECTED_DERIVATION",
          "AUTHORIZED_RECIPIENT",
          "ATTENUATED",
          "IDEMPOTENT_REPLAY"
        ]
      }
    }
  }
}
