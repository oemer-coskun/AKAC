{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WestMoneyDE/AKAC/schemas/decision.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "effect": {
      "enum": [
        "allow",
        "deny"
      ]
    },
    "code": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": [
        "deny",
        "defer"
      ],
      "description": "deny: definite policy denial. defer: authorization could not be established."
    }
  },
  "required": [
    "effect",
    "code"
  ],
  "if": {
    "properties": {
      "effect": {
        "const": "deny"
      }
    }
  },
  "then": {
    "required": [
      "category"
    ]
  },
  "else": {
    "not": {
      "required": [
        "category"
      ]
    }
  }
}
