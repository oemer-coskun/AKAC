{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WestMoneyDE/AKAC/schemas/constraint.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
      "not": {
        "enum": [
          "constructor",
          "prototype",
          "__proto__"
        ]
      }
    },
    "tenant": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
      "not": {
        "enum": [
          "constructor",
          "prototype",
          "__proto__"
        ]
      }
    },
    "kind": {
      "enum": [
        "static",
        "dynamic"
      ]
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
        "not": {
          "enum": [
            "constructor",
            "prototype",
            "__proto__"
          ]
        }
      },
      "uniqueItems": true,
      "maxItems": 64
    },
    "cardinality": {
      "type": "integer",
      "minimum": 2,
      "description": "Holding (static) or activating (dynamic) at least this many listed roles denies."
    }
  },
  "required": [
    "id",
    "tenant",
    "kind",
    "roles",
    "cardinality"
  ]
}
