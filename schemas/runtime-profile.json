{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oemer-coskun/AKAC/schemas/runtime-profile.json",
  "description": "Runtime profile policy (AKAC 0.5 draft, ADR-012). Tenant-scoped; applies to decisions whose highest transitive classification is at least `classification` and, when `destinationClass` is set, only to decisions towards that destination class. Profile ids name operator-reviewed runtime templates; AKAC never stores or emits runtime policy text.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tenant",
    "classification",
    "profiles",
    "active"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
      "not": {
        "enum": [
          "constructor",
          "prototype",
          "__proto__"
        ]
      }
    },
    "tenant": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
      "not": {
        "enum": [
          "constructor",
          "prototype",
          "__proto__"
        ]
      }
    },
    "classification": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "destinationClass": {
      "enum": [
        "internal-user",
        "internal-service",
        "model-provider",
        "tool",
        "external"
      ]
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "network": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
          "not": {
            "enum": [
              "constructor",
              "prototype",
              "__proto__"
            ]
          }
        },
        "filesystem": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
          "not": {
            "enum": [
              "constructor",
              "prototype",
              "__proto__"
            ]
          }
        },
        "tool": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
          "not": {
            "enum": [
              "constructor",
              "prototype",
              "__proto__"
            ]
          }
        },
        "credential": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
          "not": {
            "enum": [
              "constructor",
              "prototype",
              "__proto__"
            ]
          }
        }
      }
    },
    "active": {
      "type": "boolean"
    }
  }
}
