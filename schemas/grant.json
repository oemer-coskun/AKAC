{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oemer-coskun/AKAC/schemas/grant.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
      "not": {
        "enum": [
          "constructor",
          "prototype",
          "__proto__"
        ]
      }
    },
    "tenant": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
      "not": {
        "enum": [
          "constructor",
          "prototype",
          "__proto__"
        ]
      }
    },
    "subject": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
      "not": {
        "enum": [
          "constructor",
          "prototype",
          "__proto__"
        ]
      }
    },
    "agent": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
      "not": {
        "enum": [
          "constructor",
          "prototype",
          "__proto__"
        ]
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "enum": [
          "read",
          "derive",
          "write_memory",
          "share",
          "export",
          "declassify"
        ]
      },
      "uniqueItems": true
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "purposes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "notBefore": {
      "type": "integer",
      "minimum": 0
    },
    "expiresAt": {
      "type": "integer",
      "minimum": 0
    },
    "active": {
      "type": "boolean"
    },
    "parent": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
      "not": {
        "enum": [
          "constructor",
          "prototype",
          "__proto__"
        ]
      }
    },
    "activeRoles": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
        "not": {
          "enum": [
            "constructor",
            "prototype",
            "__proto__"
          ]
        }
      },
      "uniqueItems": true,
      "maxItems": 64,
      "description": "Session role activation: a subset of the subject's effective roles and of the parent grant's activeRoles."
    },
    "destinations": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
        "not": {
          "enum": [
            "constructor",
            "prototype",
            "__proto__"
          ]
        }
      },
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 64,
      "description": "Destination classes or Destination ids that share/export of this run may release to (0.4, ADR-008). A child of a restricted parent must list a subset."
    },
    "maxResults": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64,
      "description": "Most documents one disclosure of this run may return (0.4, ADR-008); a child may only lower it."
    }
  },
  "required": [
    "id",
    "tenant",
    "subject",
    "agent",
    "actions",
    "resources",
    "purposes",
    "notBefore",
    "expiresAt",
    "active"
  ]
}
