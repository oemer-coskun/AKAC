{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WestMoneyDE/AKAC/schemas/grant.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
      "not": {
        "enum": [
          "constructor",
          "prototype",
          "__proto__"
        ]
      }
    },
    "tenant": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
      "not": {
        "enum": [
          "constructor",
          "prototype",
          "__proto__"
        ]
      }
    },
    "subject": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
      "not": {
        "enum": [
          "constructor",
          "prototype",
          "__proto__"
        ]
      }
    },
    "agent": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
      "not": {
        "enum": [
          "constructor",
          "prototype",
          "__proto__"
        ]
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "enum": [
          "read",
          "derive",
          "write_memory",
          "share",
          "export",
          "declassify"
        ]
      },
      "uniqueItems": true
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "purposes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "notBefore": {
      "type": "integer",
      "minimum": 0
    },
    "expiresAt": {
      "type": "integer",
      "minimum": 0
    },
    "active": {
      "type": "boolean"
    },
    "parent": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
      "not": {
        "enum": [
          "constructor",
          "prototype",
          "__proto__"
        ]
      }
    }
  },
  "required": [
    "id",
    "tenant",
    "subject",
    "agent",
    "actions",
    "resources",
    "purposes",
    "notBefore",
    "expiresAt",
    "active"
  ]
}
