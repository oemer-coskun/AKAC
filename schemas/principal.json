{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oemer-coskun/AKAC/schemas/principal.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
      "not": {
        "enum": [
          "constructor",
          "prototype",
          "__proto__"
        ]
      }
    },
    "tenant": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
      "not": {
        "enum": [
          "constructor",
          "prototype",
          "__proto__"
        ]
      }
    },
    "kind": {
      "enum": [
        "user",
        "agent",
        "service"
      ]
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "clearance": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "active": {
      "type": "boolean"
    },
    "destination": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
      "not": {
        "enum": [
          "constructor",
          "prototype",
          "__proto__",
          "internal-user",
          "internal-service",
          "model-provider",
          "tool",
          "external"
        ]
      },
      "description": "Id of the same-tenant Destination profile that governs releases to this principal (0.4, ADR-008)."
    }
  },
  "required": [
    "id",
    "tenant",
    "kind",
    "roles",
    "projects",
    "clearance",
    "active"
  ]
}
